# Copy to .env in this same directory before running `docker compose up`.
# These are shared across services (backend validates them; ai-worker and
# gateway-sync send them). Generate real random values for anything beyond
# local hackathon dev — e.g. `openssl rand -hex 32`.

JWT_SECRET_KEY=change_me_to_a_long_random_string
AI_WORKER_API_KEY=change_me_to_a_long_random_string
